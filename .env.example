TBD_USERNAME=you@email.com
TBD_PASSWORD=yourpassword
TBD_TOTP_SECRET=BASE32TOTPSECRET
PROXY_API_KEY=any-secret-string

# Optional overrides (defaults shown)
TBD_BASE_URL=https://www.torrentbd.net
CACHE_TTL_SECONDS=300
PORT=6950
CLOAK_PROFILE_DIR=/data/cloak-profile
HEALTH_CHECK_INTERVAL_MINUTES=30
RESEED_SYNC_INTERVAL_HOURS=6
NOTIFY_WEBHOOK_URL=

# Dashboard / UI access. Leave blank to keep the dashboard open on the LAN.
DASHBOARD_API_KEY=
# Canonical external URL used in Torznab download links (e.g. http://192.168.0.55:6950).
# Leave blank to derive it from each request's Host header.
PUBLIC_BASE_URL=
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Optional: free key from https://cloakbrowser.dev/free — unlocks the newest
# Chromium build that auto-solves Cloudflare challenges. Leave blank to stay on
# the bundled 0.5.x browser (works without a key but may need manual Turnstile help).
CLOAKBROWSER_LICENSE_KEY=
